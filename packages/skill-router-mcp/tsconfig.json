{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2022", "DOM", "WebWorker"],
		"strict": true,
		"noEmit": true,
		"resolveJsonModule": true,
		"allowImportingTsExtensions": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"types": ["node", "vitest/globals"],
		"baseUrl": ".",
		"paths": {
			"@skill-router-mcp/*": ["./*"],
			"@skill-router-mcp": ["./index.ts"]
		}
	},
	"include": ["**/*.ts"],
	"exclude": ["node_modules", "dist"]
}

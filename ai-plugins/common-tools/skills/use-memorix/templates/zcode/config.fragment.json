{
	"hooks": {
		"enabled": true,
		"events": {
			"PostToolUse": [
				{
					"matcher": "^(mcp__memorix__memorix_search|memorix_search)$",
					"hooks": [
						{
							"type": "command",
							"command": "node .zcode/hooks/use-memorix-retrieval.mjs",
							"timeout": 1,
							"description": "Capture redacted Memorix retrieval candidates"
						}
					]
				}
			]
		}
	}
}

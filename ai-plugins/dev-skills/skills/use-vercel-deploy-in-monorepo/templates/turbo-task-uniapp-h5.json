{
  "$comment": "子包 turbo.json。模式 B 仅使用 build；模式 A 使用 move-h5-output-to-root 将产物放入仓库根。",
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "move-h5-output-to-root": {
      "dependsOn": ["build"],
      "outputs": ["$TURBO_ROOT$/.vercel/output/**"]
    }
  }
}

{
  "$comment": "子包 turbo.json，模式 A。build 运行 Vite 构建；^build 使其先等待 workspace 依赖的 build。",
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "move-vercel-output-to-root": {
      "dependsOn": ["build"],
      "outputs": ["$TURBO_ROOT$/.vercel/output/**"]
    }
  }
}

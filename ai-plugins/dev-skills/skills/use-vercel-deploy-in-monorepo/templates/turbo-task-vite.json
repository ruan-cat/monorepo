{
	"$comment": "适用形态 1 / 模式 A：Vite / Vue3 子包，产物搬运到 monorepo 根目录",
	"$schema": "https://turbo.build/schema.json",
	"extends": ["//"],
	"tasks": {
		"vite:build:vercel": {
			"outputs": [".vercel/output/**"]
		},
		"move-vercel-output-to-root": {
			"dependsOn": ["vite:build:vercel"],
			"outputs": [".vercel/output/**"]
		}
	}
}
